{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Specola",
  "version": "0.1.0",
  "identifier": "com.ronaldoscotti.specola",
  "build": {
    "beforeDevCommand": "npm run sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Specola",
        "width": 380,
        "height": 780,
        "minWidth": 340,
        "minHeight": 420,
        "alwaysOnTop": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQjM0MTU2NUNGMTk0RDMKUldUVGxQRmNWa0d6US8vSWJic08vREM5NlBlUHRMY3BnTXdJNHQvS1FObnRKbHZaNDlQVFRRaEIK",
      "endpoints": [
        "https://github.com/ronaldoscotti/specola/releases/latest/download/latest.json"
      ]
    }
  }
}
