# Rust / Tauri
/target
/src-tauri/target
**/*.rs.bk

# Node / web frontend
node_modules
dist
dist-ssr
*.local

# Editor / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
*.log

# Secrets — signing / notarization credentials
.env
