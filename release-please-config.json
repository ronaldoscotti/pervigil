{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "specola",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "extra-files": [
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "refactor",
          "section": "Changed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "build",
          "section": "Changed"
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "chore",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Changed",
          "hidden": true
        }
      ]
    }
  }
}
